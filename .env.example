# copie para .env e preencha. Nunca commite o .env. Salve com quebras de linha LF (o container le CRLF como parte do valor).
MESA_SENHA=troque-esta-senha
OPENAI_API_KEY=
MESA_OPENAI_MODELO=gpt-5-mini
# custo por briefing (US$ por 1M tokens; opcional)
MESA_OPENAI_PRECO_IN=
MESA_OPENAI_PRECO_OUT=
# e-mail diario (opcional). Gmail: smtp.gmail.com, porta 587, usuario = seu e-mail, senha = "senha de app"
# (Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app), NAO a senha normal.
MESA_SMTP_HOST=
MESA_SMTP_PORTA=587
MESA_SMTP_USUARIO=
MESA_SMTP_SENHA=
MESA_EMAIL_DESTINO=
